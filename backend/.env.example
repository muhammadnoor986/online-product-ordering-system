# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file.
#
# The server checks these settings when it starts. If something is missing or wrong it prints
# every problem (never the secret values) and stops with exit code 1.

# Port of the API (a whole number from 1 to 65535)
PORT=5000

# MongoDB connection string. It must start with mongodb:// or mongodb+srv://
# Atlas: dashboard -> Connect -> Drivers. Local MongoDB: mongodb://127.0.0.1:27017/online_production
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/<database_name>?retryWrites=true&w=majority

# URL of the React app (used for CORS). Only the address: no path and NO slash at the end.
CLIENT_URL=http://localhost:5173

# Secret used to sign login tokens. REQUIRED, at least 32 characters, random, never shared.
# Do not keep the placeholder below: the server refuses to start with it. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
# How long a login lasts: a number with a unit, for example 30m, 12h or 1d
JWT_EXPIRES_IN=1d

# Only when the API runs BEHIND a reverse proxy (nginx, a hosting platform, ...):
# the number of proxies between the internet and this server, for example 1.
# Leave it at false (or remove it) when visitors reach the API directly.
# The login limiter and "req.ip" rely on this. Do not use "true"; the server refuses it.
TRUST_PROXY=false

# One log line per request (method, path, status, time; never bodies, headers or queries).
# Set to false to switch it off.
LOG_REQUESTS=true

# First admin account, created by running: npm run seed:admin
# Put your REAL values in backend/.env, not in this example file.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=Admin
