# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file.

PORT=5000

# MongoDB Atlas connection string (Atlas dashboard -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/<database_name>?retryWrites=true&w=majority

# URL of the React app (used for CORS)
CLIENT_URL=http://localhost:5173

# Secret used to sign login tokens. Use a long random string and never share it.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# First admin account, created by running: npm run seed:admin
# Put your REAL values in backend/.env, not in this example file.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=Admin
